{
    "name": "gsebastiao/laravel-logintracker",
    "description": "Pacote Laravel para registar entradas e saidas (login/logout), sessoes ativas e status online dos utilizadores, numa tabela configuravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "login",
        "logout",
        "auth",
        "audit",
        "tracking",
        "online-status",
        "heartbeat"
    ],
    "authors": [
        {
            "name": "Gerson Sebastiao Cossa",
            "email": "gsebastiao@exemplo.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gsebastiao\\LoginTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gsebastiao\\LoginTracker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gsebastiao\\LoginTracker\\LoginTrackerServiceProvider"
            ],
            "aliases": {
                "LoginTracker": "Gsebastiao\\LoginTracker\\Facades\\LoginTracker"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}