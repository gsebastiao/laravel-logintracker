# Dependencias instaladas via Composer - nunca commitadas num pacote,
# quem instala o pacote gera a sua propria via `composer install`.
/vendor/
composer.lock

# Ambiente de testes (Orchestra Testbench), se/quando adicionarmos testes
/build/
.phpunit.result.cache
phpunit.xml

# Artefactos comuns de IDEs
/.idea/
/.vscode/
*.swp

# Sistema operativo
.DS_Store
Thumbs.db

# Ficheiros locais de ambiente, caso alguem crie um para testar o pacote
# isoladamente (ex: um projeto Laravel de teste dentro do proprio repo)
.env
.env.backup
